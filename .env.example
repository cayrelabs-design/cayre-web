# Copiá este archivo como .env.local y completá los valores.
# .env.local no se sube a GitHub: está en .gitignore.
#
# Son las mismas cuatro variables que hay que cargar en Vercel.
# Los valores salen de Supabase · Project Settings → API Keys.

# La dirección del proyecto de Supabase. La usan la web y el back office.
NEXT_PUBLIC_SUPABASE_URL=

# La clave PÚBLICA (publishable / anon). La usa el back office (/interno).
# Viaja al navegador y no es un secreto: lo que protege los datos son las
# reglas de la base, no esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La clave SECRETA. La usa solamente el formulario de contacto de la web, desde
# el servidor, para guardar las consultas. Nunca va en el navegador ni en un
# archivo que se suba. El back office no la usa.
SUPABASE_SECRET_KEY=

# Texto largo y aleatorio para anonimizar las IP antes de guardarlas.
# Si cambia, se pierde la cuenta de envíos previos y no pasa nada más.
CONSULTAS_SAL=

# Para probar el back office en la computadora, sin tocar la base real, no hace
# falta completar esto a mano: `node scripts/preparar-local.mjs` lo escribe solo.
