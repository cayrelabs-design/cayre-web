# Copiá este archivo como .env.local y completá los valores.
# .env.local no se sube a GitHub: está en .gitignore.

# Supabase · Project Settings → API Keys
SUPABASE_URL=
# Clave secreta: solo la usa el servidor. Nunca va en el navegador ni en un
# archivo que se suba. En Vercel se carga como variable de entorno.
SUPABASE_SECRET_KEY=

# Texto largo y aleatorio para anonimizar las IP antes de guardarlas.
# Si cambia, se pierde la cuenta de envíos previos y no pasa nada más.
CONSULTAS_SAL=

# Dirección pública. En Vercel se toma sola; definila cuando haya dominio.
# NEXT_PUBLIC_SITE_URL=https://cayrelabs.com.ar
